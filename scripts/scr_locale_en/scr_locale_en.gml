// ---------------------------------------------------------------------
// TALENTOS (por ID): [nome, descricao, efeito]
// ---------------------------------------------------------------------
function locale_en_talents_init() {
    if (variable_global_exists("tr_talent_en")) return;
    global.tr_talent_en = {};
    var _t = global.tr_talent_en;
    _t[$ "knight_postura_firme"] = ["Steady Stance", "Martial firmness with the shield raised, advancing through a hail of blows without losing speed.", "+50% movement speed while defending with the shield."];
    _t[$ "knight_lamina_afiada"] = ["Honed Blade", "Patience and technique gather power at the blade's tip while the warrior waits for the right moment.", "The first strike after 2s without attacking has a 100% critical hit chance."];
    _t[$ "knight_golpe_pesado"] = ["Heavy Blow", "A crushing impact that hurls monsters back when it lands on a weak spot.", "Critical hits deal +80% knockback and stun enemies for 0.3s."];
    _t[$ "knight_escudo_choque"] = ["Shock Shield", "The impact absorbed by the metal is channeled into a cone of air that shoves attackers away.", "Blocking a direct hit releases a cone of air that pushes enemies in front of you."];
    _t[$ "knight_segundo_folego"] = ["Second Wind", "Extreme heroic resilience that keeps the warrior standing in desperate moments.", "When falling below 25% HP, instantly recover 20% HP (Cooldown: 60s)."];
    _t[$ "knight_muralha_movel"] = ["Moving Wall", "A determined charge, shield first, to close the gap on enemies and archers.", "Running toward an enemy with the shield raised grants +30% movement speed."];
    _t[$ "knight_aco_temperado"] = ["Tempered Steel", "Precious alloys harden the armor in proportion to the riches gathered during the run.", "+1 physical defense for every 100 gold held this run (max +8)."];
    _t[$ "knight_fio_carrasco"] = ["Executioner's Edge", "Merciless cuts designed to finish off staggering foes on the brink of death.", "Deals +40% damage to any enemy below 30% HP."];
    _t[$ "knight_reflexo_blindado"] = ["Armored Reflex", "A perfectly angled shield that deflects arrows and projectiles back at their shooters.", "Projectiles that hit an active block have a 40% chance to ricochet back."];
    _t[$ "knight_vontade_indomavel"] = ["Indomitable Will", "An unshakable stance that ignores slippery ground, gales and the shoves of colossal bosses.", "Makes the Knight immune to pushes, knockback and slows from traps or bosses."];
    _t[$ "knight_paladino_bencao_mare"] = ["Tide's Blessing", "Sacred waters flow in quickened pulses, restoring flesh and healing deep wounds.", "The Overheal Aura pulses 25% faster and grants +4 HP/s natural regeneration."];
    _t[$ "knight_paladino_bastiao_liquido"] = ["Liquid Bastion", "A translucent film of water that dissolves ranged shots before they reach the body.", "The overheal barrier gains +50% max HP capacity and absorbs 100% of projectile damage."];
    _t[$ "knight_paladino_gota_purificadora"] = ["Long Thrust", "The lancer measures distance like a swamp hunter: the right strike is the one that lands with the tip.", "The water tip deals +50% damage."];
    _t[$ "knight_paladino_correnteza_dilacerante"] = ["Tide of Blades", "Every third motion, the water splits into three cutting currents.", "Every 3rd strike, the water tip splits into 3 jets in a fan."];
    _t[$ "knight_paladino_golpe_nascente"] = ["Freezing Current", "The water follows the spear without hesitation and chills whatever it touches.", "The water tip comes out twice as fast and slows the target by 40% for 1.5s."];
    _t[$ "knight_paladino_escudo_espelhado"] = ["Mirror Shield", "When the barrier breaks, the water mirror shatters in a blast that stuns attackers.", "When the overheal barrier breaks from damage, it explodes, blinding and pushing enemies within 120px."];
    _t[$ "knight_paladino_graca_abencoada"] = ["Blessed Grace", "Excess vitality is never wasted, condensing into a shield of sacred energy.", "Healing received at full HP converts 50% of the amount into overheal barrier."];
    _t[$ "knight_paladino_julgamento_sereno"] = ["Serene Judgment", "Shielded by the shining barrier, the knight wields the sword with calm, radiant rhythm.", "While the overheal barrier is active, sword attack speed increases by +25%."];
    _t[$ "knight_berserk_arco_incendiario"] = ["Expanded Rune", "Wider, hotter rune circles mark every impact of the sword.", "Fire runes gain +40% radius and +25% damage."];
    _t[$ "knight_berserk_frenesi_ardente"] = ["Chain Rune", "When a rune consumes a life, the released energy ignites a new rune.", "An enemy killed by a rune detonates another rune in its place (once per strike)."];
    _t[$ "knight_berserk_combustao_espontanea"] = ["Spontaneous Combustion", "Burning enemies reach critical mass on death and detonate among their allies.", "Enemies killed while Burning explode, dealing 60% of the attack's damage in an area."];
    _t[$ "knight_berserk_sede_sangue"] = ["Bloodthirst", "Blind fury feeds on the enemy's pain, restoring muscle and keeping the frenzy alive.", "Critical hits restore 15% of damage dealt as HP and extend Blazing Fury by +0.5s."];
    _t[$ "knight_berserk_cinzas_sacrificio"] = ["Ashes of Sacrifice", "The runic knight burns their own blood for a staggering peak of pyroclastic destruction.", "Activating Blazing Fury costs 10% of current HP but doubles the fire damage bonus for the first 3s."];
    _t[$ "knight_berserk_lamina_brasa"] = ["Ember Blade", "Volcanic heat able to melt heavy shields and crack the rocky shells of golems.", "Armored enemies lose 50% of their damage reduction against your fire attacks."];
    _t[$ "knight_berserk_vinganca_flamejante"] = ["Flaming Vengeance", "Every wound bursts a pressure valve, releasing a ring of flames around the body.", "Taking physical damage releases a flare that hits everyone within 70px."];
    _t[$ "knight_berserk_furia_imortal"] = ["Undying Fury", "A stubborn refusal to die while the fire of fury still crackles in the chest.", "While Blazing Fury is active, the player cannot be defeated (stays at 1 HP)."];
    _t[$ "knight_duelista_riposte_perfeito"] = ["Perfect Riposte", "Pinpoint timing on the enemy blade opens a gap for a deadly counter.", "Landing a Parry within 0.1s grants +100% critical damage on the counterattack."];
    _t[$ "knight_duelista_passo_eolico"] = ["Aeolian Step", "An ethereal glide fueled by the block's rebound that instantly repositions the hero.", "Blocking or parrying a hit lets you dash instantly toward your aim at no cost."];
    _t[$ "knight_duelista_combo_vendaval"] = ["Gale Combo", "The combo's second flourish cuts the air so hard it creates a flying vacuum boomerang.", "The combo's second strike fires a cutting gust that hits distant enemies."];
    _t[$ "knight_duelista_danca_laminas"] = ["Dance of Blades", "Intoxicating acrobatic flow that turns every kill into rhythmic acceleration.", "Increases base movement speed by +25% for 2s after each kill."];
    _t[$ "knight_duelista_aparar_cadeia"] = ["Chain Parry", "Rhythmic mastery that uses the previous block's momentum to parry the next one.", "Parrying a hit instantly resets the Parry cooldown."];
    _t[$ "knight_duelista_vacuo_cortante"] = ["Cutting Vacuum", "A centripetal vortex forms at the point of impact, pulling unwary monsters to the center.", "The Parry counterattack pulls all nearby enemies to the center before exploding."];
    _t[$ "knight_duelista_reflexos_celere"] = ["Swift Reflexes", "Sharpened instincts sense attack paths, leaving only afterimages in the air.", "Grants a permanent +15% passive chance to dodge any hit."];
    _t[$ "knight_duelista_estocada_fulminante"] = ["Lightning Thrust", "A surgical strike to the spine or blind spots of careless foes.", "If a combo strike hits the enemy's back, it deals 2.5x damage."];
    _t[$ "knight_guardiao_muralha_sismica"] = ["Seismic Wall", "The stance's firm impact raises massive stalagmites that choke corridors and hordes.", "The Earth Bastion creates stalagmites around you that block passages and enemies."];
    _t[$ "knight_guardiao_provocacao_esmagadora"] = ["Crushing Taunt", "A deafening war cry that shakes the monsters' courage, weakening their attacks.", "Enemies taunted by the Guardian deal 30% less damage to the player for 4s."];
    _t[$ "knight_guardiao_carapaca_granito"] = ["Granite Carapace", "A dense layer of minerals over the iron plates makes the warrior as immovable as a mountain.", "Grants +12 physical defense and immunity to any knockback or push."];
    _t[$ "knight_guardiao_retaliacao_sismica"] = ["Seismic Retaliation", "Seismic vibration returns the shock as sharp stone shards in every direction.", "Returns 50% of the damage of any hit taken as earth damage to everyone around."];
    _t[$ "knight_guardiao_fissura_telurica"] = ["Telluric Fissure", "A monumental downward strike that tears a crack in the dungeon's rocky floor.", "Every 4th sword strike cracks the ground in a line, stunning the first enemy for 0.8s."];
    _t[$ "knight_guardiao_bastiao_inabalavel"] = ["Unshakable Bastion", "The shield's unbreakable firmness anchors life force to the earth, healing the body.", "Blocking attacks converts 15% of blocked damage into temporary life regeneration."];
    _t[$ "knight_guardiao_peso_esmagador"] = ["Crushing Weight", "The shield's inertia is enormous: slamming into rocks and walls breaks bones with ease.", "Pushing an enemy into a wall deals 25 extra crushing damage per rank."];
    _t[$ "knight_guardiao_fortaleza_viva"] = ["Living Fortress", "The more surrounded and pressed by hordes, the more impenetrable the Guardian becomes.", "For each enemy within 90px, gain +3 defense and +5% damage reduction."];
    _t[$ "knight_lendario_vapor_sagrado"] = ["Sacred Steam", "The mysteries of water and fire fuse into mystic mists that cauterize and heal.", "Attacks apply scalding steam: a continuous burn that also heals the player each tick."];
    _t[$ "knight_lendario_tempestade_poeira"] = ["Dust Storm", "Earth and air whip sand into a whirlwind that deflects projectiles before they land.", "The Parry counterattack raises a sandstorm that blinds enemy projectiles for 3s."];
    _t[$ "knight_lendario_gelo_fendido"] = ["Cleft Ice", "The cold of water and the solidity of earth create crystal stakes that paralyze attackers.", "The shield's impact creates permanent ice spikes that freeze enemies who step on them."];
    _t[$ "knight_lendario_tempestade_ignea"] = ["Igneous Storm", "The wind feeds the fire's hunger, creating flaming whirlwinds that hunt down foes.", "The Duelist combo fires fire tornadoes that chase the nearest targets."];
    _t[$ "knight_lendario_avatar_elemental"] = ["Elemental Avatar", "Perfect harmony between the four elements unleashes devastating twin waves.", "+25% physical and magical attack damage and triggers combined elemental explosions."];
    _t[$ "knight_lendario_cavaleiro_apocalipse"] = ["Knight of the Apocalypse", "Flawless mastery draws the fury of the skies, calling down comets when the kill streak is perfect.", "Every 10 enemies defeated without taking damage, the next strike drops a meteor on the target."];
    _t[$ "knight_lendario_escudo_titanico"] = ["Titanic Shield", "The metal expands like a fortress gate, forming an impassable trench against hordes.", "The shield doubles in size, covering 180 degrees in front and blocking entire passages."];
    _t[$ "knight_lendario_eco_ancestrais"] = ["Echo of the Ancestors", "Heroic blood awakens memories of ancient warrior kings who mirror every strike.", "Blocking or countering summons a translucent warrior spirit that strikes a twin blow."];
    _t[$ "mage_canalizacao_fluida"] = ["Fluid Channeling", "A gliding stance that lets you cast while moving without losing rhythm.", "Moving does not interrupt casting the basic magic attack."];
    _t[$ "mage_mente_cristalina"] = ["Crystal Mind", "Unwavering focus gathers arcane density in the hands while the mage avoids being hit.", "Taking no damage for 4s grants +20% magic damage on the next spell."];
    _t[$ "mage_eco_magico"] = ["Magic Echo", "Residual resonance of the ether creates a smaller spark right after the main spell.", "Every 4th magic projectile fires an extra smaller copy dealing 50% damage."];
    _t[$ "mage_protecao_mana_reativa"] = ["Reactive Mana Ward", "The impact bursts a compressed ethereal pocket, pushing threats around you away.", "Taking a hit that removes more than 15% HP repels enemies within 120px."];
    _t[$ "mage_sobrecarga_feitico"] = ["Spell Overload", "Critical blasts that superheat the air around the magic impact point.", "Magic critical hits cause a 50px mini-explosion dealing 40% damage."];
    _t[$ "mage_condensacao_arcana"] = ["Arcane Condensation", "The projectile gathers celestial particles in flight, reaching full power at long range.", "Magic projectiles that travel more than 250px gain +25% damage and size."];
    _t[$ "mage_sifao_alma"] = ["Soul Siphon", "Quietly drains the stray life force of purged creatures to close your own wounds.", "Defeating an enemy instantly restores 3 HP."];
    _t[$ "mage_fluxo_conduzido"] = ["Guided Flow", "Aligned ley lines speed arcane shots through the dungeon air like lightning.", "+15% travel speed for all magic projectiles."];
    _t[$ "mage_ressonancia_foco"] = ["Focus Resonance", "Reinforced arcane hexagons that extend the durability of the mage's protective shield.", "The Manashield lasts +1.2s and reduces all damage taken by 25%."];
    _t[$ "mage_conhecimento_ancestral"] = ["Ancestral Knowledge", "Absorbing ancient secrets from every purged minion expands casting power.", "Gain +2 Magic Power for every 15 enemies defeated this run (max +12)."];
    _t[$ "mage_crio_geada_penetrante"] = ["Piercing Frost", "Cold crystals lodge in the monsters' joints, numbing their movements.", "Basic projectiles apply a 30% slow for 2s on every hit."];
    _t[$ "mage_crio_pico_glacial"] = ["Glacial Peak", "The gathered cold reaches near absolute zero, freezing monsters into solid blocks of ice.", "Slowed enemies are fully frozen for 1.5s when hit by magic."];
    _t[$ "mage_crio_armadura_gelo_negro"] = ["Steady Aim", "Standing still, the gunner takes a deep breath and aligns the crystal with the target's heart.", "Standing still for 1s charges the next lance: +80% damage, guaranteed critical and pierces everything."];
    _t[$ "mage_crio_onda_torrencial"] = ["Torrential Wave", "A high-pressure jet of water that sweeps entire hordes down the corridor.", "The 3rd magic attack fires a frontal tide that drags monsters 150px."];
    _t[$ "mage_crio_prisao_criogenica"] = ["Cryogenic Prison", "The ice dome shatters, releasing piercing shards in every direction.", "The Glacial Prison (X) shatters at the end, firing 6 freezing shards."];
    _t[$ "mage_crio_orvalho_restaurador"] = ["Shattering Lance", "A killing lance doesn't stop: it bursts into sharp ice fragments.", "Enemies killed by lances shatter into 4 shards (60% damage, apply slow)."];
    _t[$ "mage_crio_lanca_zero_absoluto"] = ["Absolute Zero Lance", "Thin ice spikes designed to break shells hardened by extreme cold.", "Attacks against rooted or slowed enemies have +35% critical hit chance."];
    _t[$ "mage_crio_coracao_geada"] = ["Heart of Frost", "Complete symbiosis with the cold: toxins are purged and cold becomes vitality.", "Immune to slows and poisons; converts 15% of cold damage taken into a shield."];
    _t[$ "mage_piro_centelha_incandescente"] = ["Incandescent Spark", "Living embers embedded in the projectiles keep burning the target's flesh.", "Basic projectiles set enemies on fire for 3s, dealing damage over time."];
    _t[$ "mage_piro_meteoro_menor"] = ["Lesser Meteor", "A subtle call to the cosmos brings burning stones crashing down on attackers.", "Every 5 magic hits, a lesser meteor falls, dealing 20 area damage."];
    _t[$ "mage_piro_rastro_flamejante"] = ["Flaming Trail", "Red-hot footsteps turn the dungeon floor into a trail of embers.", "Walking leaves a trail of embers for 1.5s that burns monsters who step on it."];
    _t[$ "mage_piro_inferno_expansivo"] = ["Spreading Inferno", "Charred bodies ignite spontaneously as they fall, setting their allies ablaze.", "Killing a burning enemy makes it explode, spreading fire to its neighbors."];
    _t[$ "mage_piro_ponto_fusao"] = ["Melting Point", "Extreme volcanic heat able to liquefy iron shells and magic shields.", "Fire damage ignores 50% of enemies' physical and magical armor."];
    _t[$ "mage_piro_conflagracao_furiosa"] = ["Raging Conflagration", "Glowing ashes blow furiously through the staff, speeding up new casts.", "Ignition Point (X) draws in ashes that increase casting speed by +30% for 3s."];
    _t[$ "mage_piro_sopro_dragao"] = ["Dragon's Breath", "The staff spits a torrential cone of fire instead of single projectiles.", "The basic spell becomes a continuous short-range cone of fire dealing area damage."];
    _t[$ "mage_piro_fenix_imortal"] = ["Undying Phoenix", "The phoenix's primal spark is reborn from the ashes in a healing supernova when the mage falls.", "On taking fatal damage, release a supernova that heals 35% HP (once per run)."];
    _t[$ "mage_aero_arco_eletrico"] = ["Electric Arc", "Ionized sparks leap from the main target to shock nearby enemies.", "Magic projectiles chain a secondary bolt to up to 2 nearby targets."];
    _t[$ "mage_aero_passo_cefiro"] = ["Zephyr Step", "Swift breezes push the caster's steps after channeling the wind of the heights.", "+20% base speed; increases by a further +10% for 2s after casting."];
    _t[$ "mage_aero_sobrecarga_estatica"] = ["Static Overload", "Air friction builds static voltage in the staff, ready to paralyze the attacker.", "Moving builds electric charge; at 100% charge the next attack stuns for 1s."];
    _t[$ "mage_aero_tufao_repulsor"] = ["Repelling Typhoon", "A dome of compressed wind that deflects hostile arrows and shots in midair.", "The Manashield (X) creates a circular gust that pushes enemy projectiles away."];
    _t[$ "mage_aero_salto_tempestuoso"] = ["Tempest Leap", "The electric teleport reuses the static energy gathered in the monsters' wake.", "Voltaic Distortion (X) recharges 40% faster if you pass through enemies."];
    _t[$ "mage_aero_vortice_cortante"] = ["Cutting Vortex", "The attack sequence creates a spinning whirlwind that sucks in dazed enemies.", "The 3rd consecutive projectile creates a mini-hurricane on impact that pulls weak monsters."];
    _t[$ "mage_aero_condutividade_letal"] = ["Lethal Conductivity", "Water on the ground or on bodies amplifies the voltage of the electric shock.", "Slowed or wet enemies take double lightning damage and a longer shock."];
    _t[$ "mage_aero_olho_furacao"] = ["Eye of the Hurricane", "Air pressure creates a low-density pocket where shots miss their target.", "+15% projectile dodge while the mage is moving."];
    _t[$ "mage_geo_projetil_rochoso"] = ["Rock Projectile", "Heavy basalt crystals at the core of the shot that push attackers back.", "The basic spell gains heavy stones with +60% knockback."];
    _t[$ "mage_geo_armadura_granito"] = ["Granite Armor", "Solid layers of floating rock around the cloak protect against sharp steel.", "+6 permanent Physical Defense and immunity to weak cuts."];
    _t[$ "mage_geo_tremer_terra"] = ["Earth Tremor", "Projectiles striking rocks and walls release seismic waves across the floor.", "Projectiles hitting walls create a short seismic wave on the ground that slows."];
    _t[$ "mage_geo_monolito_esmagador"] = ["Crushing Monolith", "The basalt pillar implodes when it expires, crushing everything caught in its gravity.", "The Basalt Monolith (X) collapses at the end of its duration, dealing 40 area damage."];
    _t[$ "mage_geo_espinhos_teluricos"] = ["Telluric Spikes", "Monsters hurled against obstacles suffer the violence of mineral crushing.", "Enemies pushed into walls by spells take double impact damage."];
    _t[$ "mage_geo_coracao_areia"] = ["Heart of Sand", "Golden sand condenses into a protective film with every fragment thrown.", "Gain a temporary barrier equal to 5% of damage dealt with earth magic."];
    _t[$ "mage_geo_poco_gravitacional"] = ["Gravity Well", "Dense telluric mass around the mage doubles the weight of monsters trying to surround her.", "Enemies within 70px of the mage suffer a constant 40% slow from gravity."];
    _t[$ "mage_geo_estilhaco_basalto"] = ["Basalt Shard", "Destroyed monsters release sharp basalt splinters that pierce nearby ranks.", "Kills with earth magic burst into 4 sharp fragments that pierce targets."];
    _t[$ "mage_lendario_vapor_fulminante"] = ["Searing Steam", "Ice and flames collide, releasing clouds of superheated steam.", "Enemies that are burning and frozen at the same time release boiling steam that deals area damage over time."];
    _t[$ "mage_lendario_tempestade_areia"] = ["Sandstorm", "Quartz particles blown by the wind blind attacking monsters.", "Earth projectiles release curtains of sand that make enemies miss 50% of their attacks."];
    _t[$ "mage_lendario_gelo_fendido"] = ["Cleft Ice", "Rocky ground frozen into deep permafrost, trapping monsters in icy snares.", "Ice impacts petrify the ground, freezing enemies permanently when they step on it."];
    _t[$ "mage_lendario_tempestade_plasma"] = ["Plasma Storm", "Fusing fiery fury and lightning creates homing bolts of violet plasma.", "Lightning ignites targets and creates cascading homing plasma arcs."];
    _t[$ "mage_lendario_avatar_arcano"] = ["Arcane Avatar", "Supreme mastery of the mystic web turns the body into a conduit of pure light.", "+30% total Magic Power and the Manashield absorbs 100% of damage for 1s when activated."];
    _t[$ "mage_lendario_singularidade_dimensional"] = ["Dimensional Singularity", "A collapse of space that warps the air, swallowing enemy projectiles into a black hole.", "Every 12s, the next spell creates a black hole that pulls in and destroys projectiles."];
    _t[$ "mage_lendario_chuva_cometas"] = ["Comet Rain", "Craters falling from the stars set entire rooms ablaze and reduce them to dust and embers.", "Critical hits summon giant blazing comets that crush an area."];
    _t[$ "mage_lendario_conjurador_supremo"] = ["Supreme Conjurer", "Uninterrupted celestial rhythm channels spells like an endless ethereal torrent.", "Removes the delay between magic attacks after landing 5 spells in a row."];
    _t[$ "archer_tiro_em_corrida"] = ["Running Shot", "Masterful agility that lets you loose swift arrows without slowing your run.", "Shooting while moving reduces the movement slowdown by 60%."];
    _t[$ "archer_ponto_cego"] = ["Blind Spot", "Perfect ballistics to hit weak spots at the very edge of sight.", "Arrows that hit enemies more than 300px away deal +30% critical damage."];
    _t[$ "archer_perfuracao_reta"] = ["Straight Pierce", "Aerodynamic tips that sweep through enemy ranks without losing force or veering off course.", "All arrows pierce 1 additional enemy before disappearing."];
    _t[$ "archer_aljava_leve"] = ["Light Quiver", "Quick draw from the quiver and an instant nock for continuous shooting.", "+20% base attack speed with the longbow."];
    _t[$ "archer_pontas_farpadas"] = ["Barbed Tips", "Iron hooks on the shaft that tear flesh and leave lasting bleeds.", "Critical hits apply a bleed dealing 20% of the damage over 2s."];
    _t[$ "archer_recuo_emergencia"] = ["Emergency Recoil", "A pressure spring in the bow that violently pushes attackers away when the hero is hit.", "Taking physical damage knocks the attacker back 90px (cooldown: 8s)."];
    _t[$ "archer_reflexo_cacador"] = ["Hunter's Reflex", "The roll's adrenaline leaves the bowstring ready for an instant shot.", "Using the Roll grants +25% attack speed for the next 2s."];
    _t[$ "archer_flecha_pesada"] = ["Heavy Arrow", "Reinforced black-oak shafts that knock monsters to the ground with massive impact.", "Increases arrow knockback by +50%."];
    _t[$ "archer_tiro_concentrado"] = ["Focused Shot", "Patience and controlled breathing guarantee absolute lethality on release.", "Standing still for 1.5s guarantees a critical hit on the next arrow."];
    _t[$ "archer_saque_rapido"] = ["Quick Draw", "Improved muscle rhythm that cools down dodges as true shots find their mark.", "The Roll recharges 15% faster with every critical hit."];
    _t[$ "archer_glacial_flecha_estalactite"] = ["Stalactite Arrow", "Arrows tipped with carved icicles that freeze the beasts' footsteps.", "Arrows apply a stacking 25% slow on every hit."];
    _t[$ "archer_glacial_pista_escorregadia"] = ["Slippery Track", "The roll spreads crystallized water where monsters skid and lose balance.", "The roll leaves a trail of frozen water on the ground that disorients enemies."];
    _t[$ "archer_glacial_chuva_torrencial"] = ["Torrential Rain", "A celestial volley of liquid arrows that rains over entire areas.", "Every 5th arrow rains down 4 water projectiles in a fan."];
    _t[$ "archer_glacial_flecha_arpao"] = ["Harpoon Arrow", "Cords of dew link pierced enemies, sharing the wounds among them.", "Piercing arrows link targets with water, splitting damage among up to 3 monsters."];
    _t[$ "archer_glacial_brisa_curativa"] = ["Healing Breeze", "Drops of purified water evaporate from slowed victims, restoring the archer's vitality.", "Killing slowed enemies releases droplets that restore 4 HP."];
    _t[$ "archer_glacial_nevoa_ilusoria"] = ["Illusory Mist", "A thick mist that blinds attackers in the roll area, making them strike the air.", "Enemies inside the Roll's mist lose line of sight and miss their attacks."];
    _t[$ "archer_glacial_perfurador_glacial"] = ["Glacial Piercer", "Massive shots into frozen flesh that break the target into cutting shards.", "Shots on frozen targets deal double damage and break the ice into shards."];
    _t[$ "archer_glacial_tiro_maelstrom"] = ["Maelstrom Shot", "The arrow spins into a stormy whirlpool that drags everything in its path.", "The arrow turns into a water whirlpool that swallows monsters along its path."];
    _t[$ "archer_balist_flecha_incendiaria"] = ["Incendiary Arrow", "Shafts soaked in burning pitch that cover attackers in lasting flames.", "Arrows set enemies on fire, dealing fire damage over 3s."];
    _t[$ "archer_balist_detonacao_parede"] = ["Wall Detonation", "Concentrated powder that explodes when colliding with the room's rocks.", "Arrows that hit walls explode, dealing 30 area damage."];
    _t[$ "archer_balist_tiro_fragmentacao"] = ["Fragmentation Shot", "The arrowhead shatters into three explosive fuses on impact.", "The 3rd shot fires an arrow that splits into 3 explosive sparks on impact."];
    _t[$ "archer_balist_marca_purgatorio"] = ["Mark of Purgatory", "Burning enemies spontaneously combust when struck by critical piercings.", "Burning enemies hit by critical shots explode in mass combustion."];
    _t[$ "archer_balist_propulsao_ardente"] = ["Blazing Propulsion", "The recoil blast throws the hero farther and turns the floor into boiling magma.", "Recoil Shot (X) launches the archer 50% farther and leaves flames on the ground."];
    _t[$ "archer_balist_polvora_concentrada"] = ["Concentrated Powder", "An improved chemical mix that widens the shockwave of fire explosions.", "+25% explosion radius for all of the archer's fire effects."];
    _t[$ "archer_balist_balista_piromante"] = ["Pyro Ballista", "Built-up heat turns the longbow into a cannon able to melt armor.", "Standing still builds heat; the arrow reaches extreme speed and pierces all targets."];
    _t[$ "archer_balist_fenix_cacadora"] = ["Hunting Phoenix", "A fire-winged projectile that curves its path to devastate elite monsters and bosses.", "The shot becomes a homing phoenix that chases the most dangerous enemy."];
    _t[$ "archer_venda_disparo_leque"] = ["Fan Shot", "Three arrows fired at once in a frontal arc to sweep entire corridors.", "The basic attack fires 3 arrows in a fan, each dealing 40% damage."];
    _t[$ "archer_venda_flecha_teleguiada"] = ["Homing Arrow", "Wind currents guide the arrows' tails toward hostile bodies.", "Arrows curve slightly in the air to find nearby enemies."];
    _t[$ "archer_venda_tiro_supersonico"] = ["Supersonic Shot", "Enormous muzzle speed that breaks the sound barrier and dispels smaller projectiles.", "Arrow speed doubles and the shot cancels smaller projectiles along its path."];
    _t[$ "archer_venda_rolamento_furacao"] = ["Hurricane Roll", "A wind vortex released while rolling that clears space by pushing attackers away.", "Cyclonic Dodge (X) pushes adjacent enemies away with a gust of wind."];
    _t[$ "archer_venda_danca_ventos"] = ["Dance of the Winds", "Uses the vacuum after a dodge to fire two instant shots in a row.", "Dodging successfully grants +100% attack speed for the next 2 arrows."];
    _t[$ "archer_venda_corte_tufao"] = ["Typhoon Cut", "Blades of compressed air on the arrowheads that graze monsters at the edges of the shot.", "Arrows create lateral vacuum waves that graze nearby targets."];
    _t[$ "archer_venda_passo_etereo"] = ["Ethereal Step", "Extended ethereal immateriality while the archer spins past claws and blades.", "Increases the Roll's invulnerability time by +0.15 seconds."];
    _t[$ "archer_venda_tempestade_mil_tiros"] = ["Storm of a Thousand Shots", "A machine-gun bow unleashing a torrent of gleaming arrows through the air.", "Fires a torrent of 15 ultra-fast arrows in a devastating cone ahead."];
    _t[$ "archer_terra_flecha_arpao_pedra"] = ["Stone Harpoon Arrow", "Heavy granite tips that pin monsters against columns and rock walls.", "Heavy arrows that push enemies into walls stun them for 1s."];
    _t[$ "archer_terra_tremores_impacto"] = ["Impact Tremors", "Telluric vibrations at the point of impact open fissures that slow footsteps.", "Every arrow that hits the ground releases a mini-fissure that slows by 30%."];
    _t[$ "archer_terra_flecha_enraizadora"] = ["Rooting Arrow", "Concentrated plant spores that sprout roots from the ground, holding the monster in place.", "Every 4 hits, roots burst from the ground and hold the monster in place for 2s."];
    _t[$ "archer_terra_postura_fortaleza"] = ["Fortress Stance", "Steel stakes driven into the ground prevent any push from colossal beasts.", "Anchor Stance (X) grants +15 physical defense and knockback immunity."];
    _t[$ "archer_terra_balista_obsidiana"] = ["Obsidian Ballista", "A sharp mineral piercing able to split heavy shields and shatter shells.", "Arrows have a 35% chance to shatter enemy armor and shields."];
    _t[$ "archer_terra_raizes_sanguineas"] = ["Blood Roots", "The embedded vines drain the victim's vigor, leaving it vulnerable to new impacts.", "Rooted enemies take +30% damage from any source."];
    _t[$ "archer_terra_estacas_defensivas"] = ["Defensive Stakes", "Limestone spikes left in the roll's wake to impale pursuers.", "Rolling leaves 3 stone spike traps on the ground that deal damage."];
    _t[$ "archer_terra_tiro_cataclismico"] = ["Cataclysmic Shot", "A massive stake carved from solid rock that pushes entire ranks down the corridor.", "Fires a colossal arrow that pierces the whole room, pushing monsters."];
    _t[$ "archer_lendario_flecha_aurora_glacial"] = ["Glacial Aurora Arrow", "Sharp ice mines driven into the ground that burst when monsters approach.", "Arrows plant ice stakes in the ground that explode into spikes when enemies step on them."];
    _t[$ "archer_lendario_tempestade_ignea_aerea"] = ["Aerial Igneous Storm", "Swirling winds ignite the shafts, creating three fire tornadoes across the hall.", "Fanned arrows ignite, creating three moving fire tornadoes in the room."];
    _t[$ "archer_lendario_chuva_lodo_acido"] = ["Acid Mud Rain", "Corrosive vapor that dissolves monstrous resistances and heals the archer's wounds.", "Toxic vapor arrows dissolve resistances and restore HP proportional to damage."];
    _t[$ "archer_lendario_projetil_meteorico"] = ["Meteoric Projectile", "Burning craters where the arrows land, detonating glowing shards.", "Arrows leave pools of boiling magma and shards that explode after 1s."];
    _t[$ "archer_lendario_olho_falcao_cosmico"] = ["Eye of the Cosmic Falcon", "Stellar precision that sees beyond walls, calling down gleaming celestial arrows.", "Unlimited range; critical hits fire additional celestial star arrows."];
    _t[$ "archer_lendario_atirador_fantasma"] = ["Phantom Marksman", "A spectral projection left by the roll that mirrors your shots for a few seconds.", "The roll leaves a translucent clone that shoots alongside the archer for 3s."];
    _t[$ "archer_lendario_saraivada_eterna"] = ["Eternal Volley", "Tireless hunting momentum that speeds up dodges and fire rate with every kill.", "Killing enemies resets the Roll cooldown and temporarily doubles fire rate."];
    _t[$ "archer_lendario_flecha_julgamento"] = ["Arrow of Judgment", "A beam of divine light that disintegrates weakened creatures in a celestial blast.", "Every 10th arrow fires a divine lance that disintegrates monsters below 30% HP."];
    _t[$ "assassin_golpe_jugular"] = ["Jugular Strike", "Surgical perfection at the dagger's tip, striking vital points from behind.", "Attacks from behind deal +75% critical damage."];
    _t[$ "assassin_passo_silencioso"] = ["Silent Step", "Incorporeal strides through the shadows let you flank without drawing attention.", "+25 base Movement Speed; running doesn't alert enemies out of sight."];
    _t[$ "assassin_laminas_gemeas"] = ["Twin Blades", "Symmetric cross-handed style that lands two quick slashes on every attack.", "Every basic attack delivers two quick cuts in immediate succession."];
    _t[$ "assassin_adaga_envenenada"] = ["Poisoned Dagger", "A deadly extract of crypt scorpions that corrodes the victims' blood.", "Critical hits apply deadly poison dealing damage over 4s."];
    _t[$ "assassin_saque_rapido_letal"] = ["Lethal Quick Draw", "The first strike when entering any fight lands with staggering lethality.", "Entering a room grants 100% critical chance for the first 2s of combat."];
    _t[$ "assassin_esquiva_reflexa"] = ["Reflex Dodge", "Feline instincts that slip past sharp claws at the last possible millisecond.", "+15% dodge chance; dodging successfully recharges 1s of Invisibility."];
    _t[$ "assassin_frenesi_sangue"] = ["Blood Frenzy", "The scent of warm blood quickens the daggers' pulse with every monster slain.", "Killing a monster grants +10% attack speed for 3s (stacks up to 5x)."];
    _t[$ "assassin_execucao_fria"] = ["Cold Execution", "Merciless coldness to cut down wounded monsters before they can strike back.", "Enemies below 25% HP take double damage from normal cuts."];
    _t[$ "assassin_emboscada_perfeita"] = ["Perfect Ambush", "A strike from the shadowy void stuns the surprised attacker's mind.", "Striking from Invisibility (X) stuns the target for 1.5 seconds."];
    _t[$ "assassin_presteza_sombria"] = ["Shadow Haste", "Affinity with the shadows shortens the time between moments of concealment.", "The Invisibility cooldown is reduced by 1.5 seconds."];
    _t[$ "assassin_espect_corte_fluido"] = ["Knife Fan", "Trained fingers release more blades than the eye can count.", "The 3rd strike releases 5 water tips in a fan instead of 3."];
    _t[$ "assassin_espect_gota_hemofagica"] = ["Hemophagic Drop", "The daggers condense the victim's life force, restoring the assassin's breath.", "Critical cuts drain the target's vitality, healing 4 HP per hit."];
    _t[$ "assassin_espect_nevoa_ilusoria"] = ["Illusory Mist", "A sudden dissolve into water droplets when a blow is about to land, cancelling the impact.", "When taking damage, dissolve into mist for a moment, cancelling the hit (cooldown: 20s)."];
    _t[$ "assassin_espect_adaga_criogenica"] = ["Marked Prey", "The tracker never misses the prey they marked themselves.", "Melee hits on targets with the Spectral Mark deal +60% damage (critical)."];
    _t[$ "assassin_espect_afogamento_sombrio"] = ["Shadow Drowning", "A watery vacuum sphere seals the monster's mouth, stopping spells and screams.", "Stealth attacks briefly silence and disarm the victim with a water bubble."];
    _t[$ "assassin_espect_passo_mares"] = ["Tide Step", "The ethereal mist form lasts longer, granting pure aquatic speed.", "Mist Dissipation (X) lasts +1.5s and grants +40% movement speed."];
    _t[$ "assassin_espect_estocada_gelo_fino"] = ["Thin Ice Thrust", "Striking the backs of cold-staggered targets instantly freezes their spine.", "Striking slowed enemies from behind instantly freezes the target for 1.5s."];
    _t[$ "assassin_espect_mare_ceifa"] = ["Reaping Tide", "A spinning whirl of eight consecutive cuts with sharp water blades in 360 degrees.", "Unleashes a sequence of 8 quick circular cuts that slice everything around."];
    _t[$ "assassin_vulcan_corte_incandescente"] = ["Incandescent Cut", "Red-hot blades that cauterize open wounds with lasting flames.", "Burning daggers set targets on fire, dealing damage over 3s."];
    _t[$ "assassin_vulcan_estalo_polvora"] = ["Powder Snap", "A chemical fuse at the metal's tip that detonates after three hits on the same spot.", "The 3rd consecutive attack on the same target detonates a 25-damage explosion."];
    _t[$ "assassin_vulcan_passo_explosivo"] = ["Explosive Step", "The smothering bomb spits glowing shards in a cone, blinding attackers.", "Ash Bomb (X) deals 35 fire damage and throws sparks in a cone."];
    _t[$ "assassin_vulcan_marca_enxofre"] = ["Sulfur Mark", "Sulfurous smoke weakens the beasts' muscles and the impact of their blows.", "Enemies burned by the assassin deal 30% less damage to them."];
    _t[$ "assassin_vulcan_combustao_fatal"] = ["Fatal Combustion", "Kills from behind trigger chain detonations that set the whole nearby horde ablaze.", "Killing enemies with stealth attacks makes them explode, burning anyone nearby."];
    _t[$ "assassin_vulcan_lamina_magma"] = ["Magma Blade", "Lava heat melts shells, turning slashing damage into pure fire damage.", "100% of dagger damage becomes Magical Fire Damage, ignoring physical defenses."];
    _t[$ "assassin_vulcan_adrenalina_torrida"] = ["Scorching Adrenaline", "A dungeon in flames fires up the assassin's spirit with dizzying speed.", "Each burning enemy in the room grants the hero +4% movement speed."];
    _t[$ "assassin_vulcan_supernova_sombria"] = ["Shadow Supernova", "All burns in the room detonate at once in a deafening symphony.", "Consumes all active burns in the room as immediate explosive damage."];
    _t[$ "assassin_tufao_lamina_vacuo"] = ["Vacuum Blade", "The swift slash projects blades of air that double the reach of melee attacks.", "Dagger cuts extend cutting waves that double the reach of basic attacks."];
    _t[$ "assassin_tufao_celeridade_fantasma"] = ["Phantom Celerity", "Arms that blur into wind in a dizzying slicing sequence.", "+35% permanent base attack speed with the twin daggers."];
    _t[$ "assassin_tufao_passo_sombras"] = ["Shadow Step", "Stealth executions recycle the wind's momentum for another instant teleport.", "Shadowstep (X) recharges instantly if the shadow strike kills the target."];
    _t[$ "assassin_tufao_esquiva_espectral"] = ["Spectral Dodge", "The enemy's blow cuts only wind while the hero reappears behind the victim.", "Dodging successfully instantly repositions the assassin behind the attacker."];
    _t[$ "assassin_tufao_tornado_adagas"] = ["Dagger Tornado", "Six swift strikes create a gale that hurls enemies and slices their flesh.", "Every sequence of 6 attacks launches a cutting gale that pushes targets ahead."];
    _t[$ "assassin_tufao_reflexos_celere"] = ["Swift Reflexes", "Fencing precision to split arrows and spells in midair with the knives' edge.", "Nearby projectiles can be destroyed when struck by dagger attacks."];
    _t[$ "assassin_tufao_pressao_eolica"] = ["Wind Pressure", "Compressed air in the beasts' eyes drastically reduces their accuracy.", "Enemies hit by wind cuts suffer a 30% accuracy reduction."];
    _t[$ "assassin_tufao_mil_cortes_invisiveis"] = ["Thousand Invisible Cuts", "Instant teleports between every target, slicing each with lightning-fast cuts.", "Teleports between all enemies in the room, slicing each one 3 times in 0.5s."];
    _t[$ "assassin_obsid_corte_obsidiana"] = ["Obsidian Cut", "Black volcanic-glass blades that shatter the armor of bosses and elites.", "Basic attacks completely ignore the physical armor of elites and bosses."];
    _t[$ "assassin_obsid_veneno_petrificante"] = ["Petrifying Venom", "Dense mineral toxins that harden tissue until the flesh turns to solid stone.", "Poisoned enemies build up toxin until they are petrified for 2s."];
    _t[$ "assassin_obsid_pele_petrea"] = ["Stone Skin", "Slate plates beneath the black leather ensure solidity in close combat.", "+8 permanent Physical Defense; the assassin gains great damage resistance."];
    _t[$ "assassin_obsid_armadura_sismica"] = ["Seismic Armor", "The Obsidian Carapace returns the force of physical impacts as cutting shards.", "Obsidian Carapace (X) reflects 50% of melee damage back at the attacker."];
    _t[$ "assassin_obsid_fratura_ossea"] = ["Bone Fracture", "Blunt impacts on the joints that break bones and weaken the beasts' strength.", "Critical hits from behind reduce the enemy's attack power by 25% for 4s."];
    _t[$ "assassin_obsid_mercurio_liquido"] = ["Liquid Mercury", "Liquefied heavy metals applied to wounds prolong the agony and slow the victim.", "Poisons last twice as long and apply a constant 20% slow."];
    _t[$ "assassin_obsid_mina_basalto"] = ["Basalt Mine", "Leaving invisibility plants a spiked mine that pierces whoever steps on the spot.", "Leaving invisibility drops a sharp crystal that pierces whoever steps on it."];
    _t[$ "assassin_obsid_golpe_tectonico"] = ["Tectonic Strike", "Both daggers driven into the ground open cracks that swallow nearby monsters.", "Drive the daggers into the ground, creating a short earthquake that crushes monsters around."];
    _t[$ "assassin_lendario_danca_vapor_letal"] = ["Dance of Lethal Steam", "Burning poisoned targets releases boiling gas that dissolves armor across the hall.", "Burning poisoned targets creates corrosive boiling steam that melts defenses in the room."];
    _t[$ "assassin_lendario_tempestade_cristal"] = ["Crystal Storm", "The shock of the wind shatters obsidian rocks into deadly needles in 360 degrees.", "Wind strikes break obsidian stones, scattering deadly shards in 360 degrees."];
    _t[$ "assassin_lendario_gelo_venenoso"] = ["Venomous Ice", "Frozen green crystals where toxins work three times as fast without waking the victim from the ice.", "Frozen monsters take poison damage 3x faster without thawing."];
    _t[$ "assassin_lendario_lamina_plasma_igneo"] = ["Igneous Plasma Blade", "Golden lightning ignites the daggers, unleashing a storm of continuous slicing.", "Electric critical hits ignite and increase attack rate by +50% for 3s."];
    _t[$ "assassin_lendario_sombra_suprema"] = ["Supreme Shadow", "Total immersion in darkness doubles speed and guarantees three clean kills.", "Invisibility doubles running speed and guarantees 3 critical hits in a row."];
    _t[$ "assassin_lendario_ceifador_cosmico"] = ["Cosmic Reaper", "The perfect kill grants a split second of stellar intangibility and healing.", "Killing any monster restores 10% max HP and grants 1s of pure intangibility."];
    _t[$ "assassin_lendario_lamina_guilhotina"] = ["Guillotine Blade", "A summary strike to the neck that beheads badly wounded prey without mercy.", "If the target is below 15% HP, a strike from behind kills it instantly."];
    _t[$ "assassin_lendario_eco_assassinos"] = ["Echo of the Assassins", "A spectral twin shadow repeats every critical cut the master lands.", "Every critical hit conjures a shadow clone that instantly repeats the same strike."];
    _t[$ "general_vigor"] = ["Vigor", "Organic vitality that raises the body's natural recovery speed.", "+1 HP Regeneration per second per rank."];
    _t[$ "general_fortuna"] = ["Fortune", "An affinity for riches that multiplies the gold found on the journey.", "+15% additional Gold received per rank."];
    _t[$ "general_reflexos"] = ["Reflexes", "Sharp instincts that let you dodge sudden attacks.", "+2.5% total Dodge Chance per rank."];
    _t[$ "general_folego_extra"] = ["Extra Wind", "On the brink of defeat, the hero gets an emergency second chance with restored health.", "+1 Second Wind charge (revives immediately when you fall)."];
    _t[$ "general_impeto"] = ["Impetus", "An intense martial rhythm that cools down abilities and specials faster.", "+3% Cooldown Reduction (CDR) per rank."];
    _t[$ "general_presteza"] = ["Swiftness", "Faster handling of any weapon you wield.", "+8% Attack Speed per rank."];
    _t[$ "general_precisao"] = ["Precision", "A keen eye for flaws in the enemy's stance and for striking vital points.", "+3% Critical Hit Chance per rank (capped at 40%)."];
    _t[$ "general_forca"] = ["Brute Strength", "Martial muscle and impact power with the basic weapon.", "+3 Physical Power (increases weapon Auto-Attack damage)."];
    _t[$ "general_essencia"] = ["Arcane Essence", "Primordial arcane force that intensifies special abilities, auras and elemental effects.", "+3 Magic Power (amplifies Abilities, Healing and Elemental Effects)."];
    _t[$ "general_couraca"] = ["Steel Cuirass", "Reinforced plates that absorb the shock of direct impacts and mechanical traps.", "+3 Physical Defense (mitigates melee damage and contact traps)."];
    _t[$ "general_aura"] = ["Protective Aura", "An ethereal protective field that dissipates ranged shots and area hazards.", "+3 Magic Defense (mitigates ranged projectiles and area hazards)."];
}
