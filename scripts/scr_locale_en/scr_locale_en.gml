    _d[$ "PRECISAO!"] = "PRECISION!";
    _d[$ "PRESA MARCADA!"] = "MARKED PREY!";
    _d[$ "PRESO AO CHAO! ATAQUE!"] = "PINNED DOWN! ATTACK!";
    _d[$ "PRESO NA BOLHA!"] = "TRAPPED IN A BUBBLE!";
    _d[$ "PRESSÃO EÓLICA"] = "WIND PRESSURE";
    _d[$ "PURGATORIO!"] = "PURGATORY!";
    _d[$ "QUICOU NO ESCUDO!"] = "BOUNCED OFF THE SHIELD!";
    _d[$ "RAIZES SANGUINEAS!"] = "BLOOD ROOTS!";
    _d[$ "REBATIDA NO ESCUDO!"] = "BLOCKED BY THE SHIELD!";
    _d[$ "REBATIDO!"] = "RETURNED!";
    _d[$ "RECARGA SOMBRIA!"] = "SHADOW RECHARGE!";
    _d[$ "REFLETIDO!"] = "REFLECTED!";
    _d[$ "REFLEXO!"] = "REFLEX!";
    _d[$ "REUNIDO!"] = "REUNITED!";
    _d[$ "RICOCHETE!"] = "RICOCHET!";
    _d[$ "ROCHA FUNDIDA"] = "MOLTEN ROCK";
    _d[$ "RUNA EM CADEIA!"] = "CHAIN RUNE!";
    _d[$ "SAQUE RAPIDO!"] = "QUICK DRAW!";
    _d[$ "SINGULARIDADE!"] = "SINGULARITY!";
    _d[$ "SOBRECARGA!"] = "OVERLOAD!";
    _d[$ "SOBRECARGA! ESCUDO CAIU!"] = "OVERLOAD! SHIELD DOWN!";
    _d[$ "SOBREVIDA!"] = "OVERHEAL!";
    _d[$ "SUPERNOVA SOMBRIA!"] = "SHADOW SUPERNOVA!";
    _d[$ "TEMPESTADE DE CRISTAL!"] = "CRYSTAL STORM!";
    _d[$ "TONTO!"] = "DIZZY!";
    _d[$ "TORMENTA IGNEA"] = "IGNEOUS STORM";
    _d[$ "TORNADO DE ADAGAS!"] = "DAGGER TORNADO!";
    _d[$ "TORNADO IGNEO!"] = "FIRE TORNADO!";
    _d[$ "TREMOR!"] = "TREMOR!";
    _d[$ "VAI EXPLODIR!"] = "ABOUT TO BLOW!";
    _d[$ "VAPOR FULMINANTE!"] = "SEARING STEAM!";
    _d[$ "VAPOR LETAL!"] = "LETHAL STEAM!";
    _d[$ "VORTICE CORTANTE!"] = "CUTTING VORTEX!";
    _d[$ "ZERO ABSOLUTO!"] = "ABSOLUTE ZERO!";

    // ---------------------------------------------------------------------
    // PEDACOS PARA TEXTOS COM NUMEROS (trocados em ordem, so quando a frase
    // inteira nao esta no dicionario)
