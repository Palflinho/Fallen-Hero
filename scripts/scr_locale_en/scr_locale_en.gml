// =========================================================================
// DICIONARIO PORTUGUES -> INGLES (Fallen Hero)
// =========================================================================
// A chave e a propria frase em portugues, exatamente como esta no codigo.
// tr("CONGELADO!") devolve "FROZEN!" quando o idioma e ingles.
// Para textos com numeros (ex.: "FASE 2!"), use global.tr_en_parts:
// pedacos que sao trocados quando a frase inteira nao esta no dicionario.
// Ao criar um texto novo, adicione aqui a traducao.
// =========================================================================

function locale_en_init() {
    if (variable_global_exists("tr_en")) return;
    global.tr_en = {};
    var _d = global.tr_en;

    // ---------------------------------------------------------------------
    // AVISOS FLUTUANTES DE COMBATE
    // ---------------------------------------------------------------------
    _d[$ "* BAU DE TALENTO RARO! *"] = "* RARE TALENT CHEST! *";
    _d[$ "* GUILHOTINA! *"] = "* GUILLOTINE! *";
    _d[$ "* MIL CORTES! *"] = "* THOUSAND CUTS! *";
    _d[$ "+15 VELOCIDADE!"] = "+15 SPEED!";
    _d[$ "+2 PODER!"] = "+2 POWER!";
    _d[$ "+25 HP MAX!"] = "+25 MAX HP!";
    _d[$ "+3 DEFESA!"] = "+3 DEFENSE!";
    _d[$ "+3 PODER!"] = "+3 POWER!";
    _d[$ "ABATIDO!"] = "SHOT DOWN!";
