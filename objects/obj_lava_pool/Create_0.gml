// Fire's answer to the water maze's ice patch: starts inert (safe to walk on -- it just
// looks like scorched ground/a dormant pool), and the hidden button raises the lava level,
// turning it into a damage-over-time hazard for the rest of the run.
base_size = 32;
active = false;
tick_damage = 6;
tick_interval = 0.5;
tick_timer = 0;
